{
  "manifest_version": 3,
  "name": "MangaReader TR - Tek Tuşla Çevir",
  "version": "1.0",
  "description": "Manga sayfalarını yerel BallonsTranslator backend ile Türkçeye çevirir.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}